TMDB_API_KEY=$TMDB_API_KEY

# Release signing (run `make keygen` to generate the keystore)
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEY_ALIAS=mofy
KEY_PASSWORD=

# Watch Together signaling relay (optional). Empty = embed local WS on host.
# WT_SIGNALING_URL=ws://192.168.1.20:8787
# WT_SIGNALING_URL=wss://mofy-sig.fly.dev
WT_SIGNALING_URL=
